# Copy this file to `.env` and fill in your real values.
# The real .env is gitignored — never commit it.

# OANDA API credentials
# Get these from https://www.oanda.com/demo-account/tpa/personal_token
OANDA_ACCOUNT_ID=your-account-id-here
OANDA_API_KEY=your-api-key-here

# "practice" (demo, no real money) or "live"
OANDA_ENVIRONMENT=practice

# Password for the dashboard basic-auth prompt (used on Fly deploys).
# Leave unset locally to run without auth.
# DASHBOARD_PASSWORD=pick-a-strong-password
